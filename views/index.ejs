<%- include('partials/head') %>

<section class="hero">
  <div class="container hero-inner">
    <p class="hero-badge">🇮🇳 India's job app for delivery, drivers, security, housekeeping &amp; more</p>
    <h1>Find a job near you</h1>
    <p class="hero-sub">
      Salary in ₹ per month. No resume, no English test, no fee. Apply with your name and mobile
      number — employers call you back directly.
    </p>

    <form class="search-card" action="/" method="get" role="search" aria-label="Search jobs">
      <div class="search-row">
        <label class="search-field search-field--grow">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <input
            type="search"
            name="q"
            value="<%= filters.q %>"
            placeholder="Job title or skill, e.g. driver, cook, guard"
            aria-label="Job title or skill"
            autocomplete="off"
          />
        </label>

        <label class="search-field search-field--city">
          <span class="search-icon" aria-hidden="true">📍</span>
          <select name="city" aria-label="City">
            <option value="">All cities</option>
            <% cities.forEach(function (entry) { %>
            <option value="<%= entry.city %>" <%= filters.city === entry.city ? 'selected' : '' %>>
              <%= entry.city %> (<%= entry.count %>)
            </option>
            <% }); %>
          </select>
        </label>

        <button class="btn btn--accent search-submit" type="submit">Search jobs</button>
      </div>

      <details class="search-more" <%= filters.category || filters.experience || filters.type || filters.workMode || filters.location ? 'open' : '' %>>
        <summary>More filters</summary>
        <div class="search-more-grid">
          <label class="field">
            <span class="field-label">Category</span>
            <select name="category">
              <option value="">All categories</option>
              <% categories.forEach(function (category) { %>
              <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
              <% }); %>
            </select>
          </label>

          <label class="field">
            <span class="field-label">Experience</span>
            <select name="experience">
              <option value="">Any experience</option>
              <% experienceLevels.forEach(function (level) { %>
              <option value="<%= level %>" <%= filters.experience === level ? 'selected' : '' %>><%= level %></option>
              <% }); %>
            </select>
          </label>

          <label class="field">
            <span class="field-label">Job type</span>
            <select name="type">
              <option value="">Any type</option>
              <% types.forEach(function (type) { %>
              <option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= type %></option>
              <% }); %>
            </select>
          </label>

          <label class="field">
            <span class="field-label">Work mode</span>
            <select name="workMode">
              <option value="">Any mode</option>
              <% workModes.forEach(function (mode) { %>
              <option value="<%= mode %>" <%= filters.workMode === mode ? 'selected' : '' %>><%= mode %></option>
              <% }); %>
            </select>
          </label>

          <label class="field field--full">
            <span class="field-label">Area / locality</span>
            <select name="location">
              <option value="">Any area</option>
              <% locations.forEach(function (location) { %>
              <option value="<%= location %>" <%= filters.location === location ? 'selected' : '' %>><%= location %></option>
              <% }); %>
            </select>
          </label>
        </div>
      </details>
    </form>

    <ul class="stats hero-stats" aria-label="Site statistics">
      <li><strong><%= stats.jobs %></strong><span>jobs hiring now</span></li>
      <li><strong><%= stats.companies %></strong><span>companies</span></li>
      <li><strong><%= stats.cities %></strong><span>cities</span></li>
      <li><strong><%= stats.categories %></strong><span>categories</span></li>
    </ul>
  </div>
</section>

<section class="trust-band" aria-label="Why candidates trust Karmaadhar">
  <div class="container trust-grid">
    <div class="trust-item"><span aria-hidden="true">✅</span><p><strong>Verified employers</strong>Salary and location shown before you apply</p></div>
    <div class="trust-item"><span aria-hidden="true">📞</span><p><strong>No resume needed</strong>Apply with name and mobile number</p></div>
    <div class="trust-item"><span aria-hidden="true">⚡</span><p><strong>Apply in 2 minutes</strong>Employers call back within a week</p></div>
  </div>
</section>

<section class="container categories" aria-labelledby="categories-heading">
  <div class="section-head">
    <h2 id="categories-heading">Browse jobs by category</h2>
    <a class="text-link" href="/">See all jobs →</a>
  </div>
  <ul class="category-grid">
    <% categoryTiles.forEach(function (tile) { %>
    <li>
      <a class="category-tile" href="/?category=<%= encodeURIComponent(tile.category) %>">
        <span class="category-icon tint-<%= tile.tint %>" aria-hidden="true"><%= tile.icon %></span>
        <span class="category-name"><%= tile.category %></span>
        <span class="category-count"><%= tile.count %> job<%= tile.count === 1 ? '' : 's' %></span>
      </a>
    </li>
    <% }); %>
  </ul>
</section>

<section class="container results" aria-labelledby="results-heading">
  <div class="results-head">
    <div>
      <h2 id="results-heading">
        <% if (hasFilters) { %>
          <%= jobs.length %> matching job<%= jobs.length === 1 ? '' : 's' %>
        <% } else { %>
          Jobs for you
        <% } %>
      </h2>
      <p class="results-sub">
        <% if (hasFilters) { %>
          Filtered by your search. <a href="/">Clear all filters</a>
        <% } else { %>
          New openings from employers hiring in your city right now.
        <% } %>
      </p>
    </div>
    <div class="quick-filters" aria-label="Quick filters">
      <a class="chip" href="/?experience=Fresher">Fresher jobs</a>
      <a class="chip" href="/?workMode=Remote">Work from home</a>
      <a class="chip" href="/?type=Part-time">Part time</a>
      <a class="chip" href="/?category=<%= encodeURIComponent('Security Guard') %>">Security</a>
      <a class="chip" href="/?category=<%= encodeURIComponent('Delivery') %>">Delivery</a>
    </div>
  </div>

  <% if (jobs.length === 0) { %>
  <div class="empty-state">
    <h3>No jobs match that search</h3>
    <p>Try a different job title or city, or clear the filters to see every opening today.</p>
    <a class="btn btn--primary" href="/">Show all jobs</a>
  </div>
  <% } else { %>
  <ul class="job-list">
    <% jobs.forEach(function (job) { %>
    <% const meta = categoryMeta(job.category); %>
    <li>
      <article class="job-card">
        <div class="job-card-main">
          <span class="job-card-icon tint-<%= meta.tint %>" aria-hidden="true"><%= meta.icon %></span>
          <div class="job-card-body">
            <h3 class="job-title">
              <a href="/jobs/<%= job.id %>"><%= job.title %></a>
            </h3>
            <p class="job-salary"><%= formatSalary(job) %></p>
            <p class="job-sub"><%= job.company %> · <%= job.category %></p>
            <ul class="job-meta">
              <li><span aria-hidden="true">📍</span><%= job.location %></li>
              <li><span aria-hidden="true">💼</span><%= job.experience %></li>
              <li><span aria-hidden="true">🎓</span><%= job.qualification %></li>
              <li><span aria-hidden="true">🕒</span><%= job.type %></li>
            </ul>
          </div>
        </div>
        <div class="job-card-foot">
          <span class="posted"><%= timeAgo(job.postedAt) %></span>
          <a class="btn btn--primary btn--sm" href="/jobs/<%= job.id %>">Apply now</a>
        </div>
      </article>
    </li>
    <% }); %>
  </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
