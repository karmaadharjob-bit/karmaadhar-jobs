<%- include('partials/head') %>

<% const meta = categoryMeta(job.category); %>

<div class="container detail-layout">
  <article class="job-detail">
    <a class="back-link" href="/">← All jobs</a>

    <% if (posted) { %>
    <div class="notice notice--success" role="status">
      <strong>Your job is live.</strong> It is now listed on the home page and open for applications.
    </div>
    <% } %>

    <header class="job-head">
      <span class="job-card-icon job-card-icon--lg tint-<%= meta.tint %>" aria-hidden="true"><%= meta.icon %></span>
      <div class="job-head-body">
        <h1><%= job.title %></h1>
        <p class="job-salary job-salary--lg"><%= formatSalary(job) %></p>
        <p class="job-sub"><%= job.company %> · <%= job.category %></p>
        <ul class="job-meta">
          <li><span aria-hidden="true">📍</span><%= job.location %></li>
          <li><span aria-hidden="true">💼</span><%= job.experience %></li>
          <li><span aria-hidden="true">🎓</span><%= job.qualification %></li>
          <li><span aria-hidden="true">🕒</span><%= job.type %></li>
          <% if (job.workMode) { %><li><span aria-hidden="true">🏢</span><%= job.workMode %></li><% } %>
        </ul>
      </div>
    </header>

    <a class="btn btn--accent btn--block mobile-apply" href="#apply">Apply for this job</a>

    <dl class="detail-table">
      <div><dt>Salary</dt><dd><%= formatSalary(job) %></dd></div>
      <div><dt>Experience</dt><dd><%= job.experience %></dd></div>
      <div><dt>Qualification</dt><dd><%= job.qualification %></dd></div>
      <div><dt>Job type</dt><dd><%= job.type %></dd></div>
      <div><dt>Area</dt><dd><%= job.location %></dd></div>
      <div><dt>Posted</dt><dd><%= timeAgo(job.postedAt) %></dd></div>
      <div><dt>Applicants</dt><dd><%= applicants %></dd></div>
      <div><dt>Category</dt><dd><%= job.category %></dd></div>
    </dl>

    <section class="section-block">
      <h2>Job description</h2>
      <p><%= job.description %></p>
    </section>

    <% if (job.responsibilities && job.responsibilities.length) { %>
    <section class="section-block">
      <h2>Your daily work</h2>
      <ul class="bullet-list">
        <% job.responsibilities.forEach(function (item) { %>
        <li><%= item %></li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <% if (job.requirements && job.requirements.length) { %>
    <section class="section-block">
      <h2>Who can apply</h2>
      <ul class="bullet-list">
        <% job.requirements.forEach(function (item) { %>
        <li><%= item %></li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <% if (job.skills && job.skills.length) { %>
    <section class="section-block">
      <h2>Skills</h2>
      <ul class="tag-list">
        <% job.skills.forEach(function (skill) { %>
        <li class="tag"><%= skill %></li>
        <% }); %>
      </ul>
    </section>
    <% } %>
  </article>

  <aside class="apply-card" id="apply" aria-labelledby="apply-heading">
    <% if (applied) { %>
    <div class="success-panel">
      <span class="success-check" aria-hidden="true">✓</span>
      <h2 id="apply-heading">Application sent</h2>
      <p>
        Your application for <strong><%= job.title %></strong> has reached
        <%= job.company %>. They usually call back within a week.
      </p>
      <a class="btn btn--primary" href="/">Browse more jobs</a>
    </div>
    <% } else { %>
    <h2 id="apply-heading">Apply for this job</h2>
    <p class="apply-sub">No resume needed. Employers see your name and mobile number.</p>

    <form action="/jobs/<%= job.id %>/apply" method="post" novalidate>
      <div class="form-field">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" value="<%= values.name || '' %>" required
          <%= errors.name ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.name) { %><p class="error-text"><%= errors.name %></p><% } %>
      </div>

      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>" required
          <%= errors.email ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.email) { %><p class="error-text"><%= errors.email %></p><% } %>
      </div>

      <div class="form-field">
        <label for="phone">Mobile number <span class="optional">(optional)</span></label>
        <input id="phone" name="phone" type="tel" inputmode="tel" value="<%= values.phone || '' %>"
          placeholder="10-digit mobile number"
          <%= errors.phone ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.phone) { %><p class="error-text"><%= errors.phone %></p><% } %>
      </div>

      <div class="form-field">
        <label for="portfolio">Resume or profile link <span class="optional">(optional)</span></label>
        <input id="portfolio" name="portfolio" type="url" value="<%= values.portfolio || '' %>"
          placeholder="https://" <%= errors.portfolio ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.portfolio) { %><p class="error-text"><%= errors.portfolio %></p><% } %>
      </div>

      <div class="form-field">
        <label for="coverLetter">Why should they hire you?</label>
        <textarea id="coverLetter" name="coverLetter" rows="5" required
          placeholder="For example: I have 2 years of delivery experience in Andheri and own a bike."
          <%= errors.coverLetter ? 'aria-invalid="true" class="input--error"' : '' %>><%= values.coverLetter || '' %></textarea>
        <% if (errors.coverLetter) { %><p class="error-text"><%= errors.coverLetter %></p><% } %>
      </div>

      <button class="btn btn--accent btn--block" type="submit">Send application</button>
      <p class="form-hint">Your details are shared only with <%= job.company %>.</p>
    </form>
    <% } %>
  </aside>
</div>

<%- include('partials/footer') %>
