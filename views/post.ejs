<%- include('partials/head') %>

<div class="container narrow">
  <header class="page-header">
    <p class="eyebrow">For employers</p>
    <h1>Post a job in two minutes</h1>
    <p>
      Reach delivery riders, drivers, security guards, cooks, electricians and other blue-collar
      workers in your city. Listings go live immediately and are free to post. Mention the monthly
      salary — jobs with a clear salary get three times more applications.
    </p>
  </header>

  <% if (Object.keys(errors).length) { %>
  <div class="notice notice--error" role="alert">
    <strong>Please fix these fields.</strong>
    <ul class="bullet-list">
      <% Object.keys(errors).forEach(function (key) { %>
      <li><%= errors[key] %></li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <form class="post-form" action="/post" method="post" novalidate>
    <fieldset class="form-section">
      <legend>Job details</legend>

      <div class="form-field">
        <label for="title">Job title</label>
        <input id="title" name="title" type="text" value="<%= values.title || '' %>" required
          placeholder="e.g. Delivery Executive, Security Guard, Cook"
          <%= errors.title ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.title) { %><p class="error-text"><%= errors.title %></p><% } %>
      </div>

      <div class="form-field">
        <label for="company">Company or shop name</label>
        <input id="company" name="company" type="text" value="<%= values.company || '' %>" required
          placeholder="e.g. Shree Logistics, Blinkit, Hotel Ajanta"
          <%= errors.company ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.company) { %><p class="error-text"><%= errors.company %></p><% } %>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="category">Category</label>
          <select id="category" name="category" required
            <%= errors.category ? 'aria-invalid="true" class="input--error"' : '' %>>
            <option value="">Choose a category</option>
            <% jobCategories.forEach(function (category) { %>
            <option value="<%= category %>" <%= values.category === category ? 'selected' : '' %>><%= category %></option>
            <% }); %>
          </select>
          <% if (errors.category) { %><p class="error-text"><%= errors.category %></p><% } %>
        </div>

        <div class="form-field">
          <label for="experience">Experience needed</label>
          <select id="experience" name="experience"
            <%= errors.experience ? 'aria-invalid="true" class="input--error"' : '' %>>
            <% experienceOptions.forEach(function (level) { %>
            <option value="<%= level %>" <%= values.experience === level ? 'selected' : '' %>><%= level %></option>
            <% }); %>
          </select>
          <% if (errors.experience) { %><p class="error-text"><%= errors.experience %></p><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="qualification">Minimum qualification</label>
          <select id="qualification" name="qualification"
            <%= errors.qualification ? 'aria-invalid="true" class="input--error"' : '' %>>
            <% qualifications.forEach(function (item) { %>
            <option value="<%= item %>" <%= values.qualification === item ? 'selected' : '' %>><%= item %></option>
            <% }); %>
          </select>
          <% if (errors.qualification) { %><p class="error-text"><%= errors.qualification %></p><% } %>
        </div>

        <div class="form-field">
          <label for="city">City</label>
          <input id="city" name="city" type="text" value="<%= values.city || '' %>"
            placeholder="e.g. Mumbai" list="city-options"
            <%= errors.city ? 'aria-invalid="true" class="input--error"' : '' %> />
          <datalist id="city-options">
            <% cities.forEach(function (entry) { %>
            <option value="<%= entry.city %>"></option>
            <% }); %>
          </datalist>
          <% if (errors.city) { %><p class="error-text"><%= errors.city %></p><% } %>
        </div>
      </div>

      <div class="form-field">
        <label for="location">Area / locality</label>
        <input id="location" name="location" type="text" value="<%= values.location || '' %>" required
          placeholder="e.g. Andheri East, Mumbai"
          <%= errors.location ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.location) { %><p class="error-text"><%= errors.location %></p><% } %>
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>Pay and shift</legend>

      <div class="form-row">
        <div class="form-field">
          <label for="salaryMin">Salary from (₹ per month)</label>
          <input id="salaryMin" name="salaryMin" type="number" min="0" step="500"
            value="<%= values.salaryMin || '' %>" placeholder="18000"
            <%= errors.salaryMin ? 'aria-invalid="true" class="input--error"' : '' %> />
          <% if (errors.salaryMin) { %><p class="error-text"><%= errors.salaryMin %></p><% } %>
        </div>

        <div class="form-field">
          <label for="salaryMax">Salary up to (₹ per month)</label>
          <input id="salaryMax" name="salaryMax" type="number" min="0" step="500"
            value="<%= values.salaryMax || '' %>" placeholder="25000"
            <%= errors.salaryMax ? 'aria-invalid="true" class="input--error"' : '' %> />
          <% if (errors.salaryMax) { %><p class="error-text"><%= errors.salaryMax %></p><% } %>
        </div>
      </div>

      <input type="hidden" name="salaryPeriod" value="month" />
      <p class="form-hint">Candidates see the range as ₹18,000 – ₹25,000 per month.</p>

      <div class="form-row">
        <div class="form-field">
          <label for="type">Job type</label>
          <select id="type" name="type"
            <%= errors.type ? 'aria-invalid="true" class="input--error"' : '' %>>
            <% types.forEach(function (type) { %>
            <option value="<%= type %>" <%= values.type === type ? 'selected' : '' %>><%= type %></option>
            <% }); %>
          </select>
          <% if (errors.type) { %><p class="error-text"><%= errors.type %></p><% } %>
        </div>

        <div class="form-field">
          <label for="workMode">Work mode</label>
          <select id="workMode" name="workMode"
            <%= errors.workMode ? 'aria-invalid="true" class="input--error"' : '' %>>
            <% workModes.forEach(function (mode) { %>
            <option value="<%= mode %>" <%= values.workMode === mode ? 'selected' : '' %>><%= mode %></option>
            <% }); %>
          </select>
          <% if (errors.workMode) { %><p class="error-text"><%= errors.workMode %></p><% } %>
        </div>
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>What the work is</legend>

      <div class="form-field">
        <label for="description">Job description</label>
        <textarea id="description" name="description" rows="5" required
          placeholder="Explain the daily work, shift timings and who the job suits (at least 40 characters)."
          <%= errors.description ? 'aria-invalid="true" class="input--error"' : '' %>><%= values.description || '' %></textarea>
        <% if (errors.description) { %><p class="error-text"><%= errors.description %></p><% } %>
      </div>

      <div class="form-field">
        <label for="responsibilities">Daily responsibilities <span class="optional">(one per line)</span></label>
        <textarea id="responsibilities" name="responsibilities" rows="4"
          placeholder="Deliver grocery orders in the assigned area&#10;Update delivery status in the app"
          <%= errors.responsibilities ? 'aria-invalid="true" class="input--error"' : '' %>><%= values.responsibilities || '' %></textarea>
        <% if (errors.responsibilities) { %><p class="error-text"><%= errors.responsibilities %></p><% } %>
      </div>

      <div class="form-field">
        <label for="requirements">Who can apply <span class="optional">(one per line)</span></label>
        <textarea id="requirements" name="requirements" rows="4"
          placeholder="Own a two-wheeler with valid licence&#10;Aadhaar card and PAN card"
          <%= errors.requirements ? 'aria-invalid="true" class="input--error"' : '' %>><%= values.requirements || '' %></textarea>
        <% if (errors.requirements) { %><p class="error-text"><%= errors.requirements %></p><% } %>
      </div>

      <div class="form-field">
        <label for="skills">Skills <span class="optional">(comma separated)</span></label>
        <input id="skills" name="skills" type="text" value="<%= values.skills || '' %>"
          placeholder="Two-wheeler, Route Knowledge, Hindi"
          <%= errors.skills ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.skills) { %><p class="error-text"><%= errors.skills %></p><% } %>
      </div>

      <div class="form-field">
        <label for="contactEmail">Contact email for applications</label>
        <input id="contactEmail" name="contactEmail" type="email" value="<%= values.contactEmail || '' %>" required
          placeholder="hiring@yourcompany.in"
          <%= errors.contactEmail ? 'aria-invalid="true" class="input--error"' : '' %> />
        <% if (errors.contactEmail) { %><p class="error-text"><%= errors.contactEmail %></p><% } %>
      </div>
    </fieldset>

    <button class="btn btn--accent btn--block btn--lg" type="submit">Publish job</button>
    <p class="form-hint">Your listing appears on the home page immediately and candidates apply with name and mobile number.</p>
  </form>
</div>

<%- include('partials/footer') %>
